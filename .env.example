POSTGRES_USER=fissio
POSTGRES_PASSWORD=fissio_dev_password
POSTGRES_DB=fissio
JWT_SECRET=dev_only_change_me

# OCR Subsystem Configuration (Phase 4 & 5)
OCR_ENGINE=paddleocr
OCR_VERSION=PP-OCRv4
OCR_MODEL_VARIANT=mobile
OCR_LANG=tr
OCR_USE_GPU=false
OCR_SERVICE_URL=http://ocr:8080
OCR_PREPROCESS=true
OCR_PREPROCESS_WARP=true
OCR_PREPROCESS_CLAHE=false
OCR_DET_LIMIT_SIDE_LEN=1600

# Otomatik kategorilendirme: bu guvenin altindaki eslesmeler "Diger"e duser ve kullaniciya kontrol ettirilir (0-1)
CATEGORY_MIN_CONFIDENCE=0.5
