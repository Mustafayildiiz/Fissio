POSTGRES_USER=fissio
POSTGRES_PASSWORD=fissio_dev_password
POSTGRES_DB=fissio
JWT_SECRET=dev_only_change_me
# Access token (15 dk) imza anahtari: auth ve expense'te AYNI olmali. Bos birakilirsa JWT_SECRET kullanilir.
JWT_ACCESS_SECRET=
# Refresh token (30 gun, DB'de hash'li) ve OTP hash anahtari: yalniz auth. Bos ise JWT_SECRET'ten turetilir.
JWT_REFRESH_SECRET=
# E-posta dogrulama / sifre sifirlama kodunun gecerlilik suresi (dakika)
OTP_TTL_MINUTES=10

# E-posta (SMTP). SMTP_HOST bos birakilirsa kodlar e-posta yerine auth servisinin loguna yazilir
# (yalniz gelistirme/test): docker compose logs auth | grep DEV-OTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Fissio <no-reply@example.com>

# OCR Subsystem Configuration (Phase 4 & 5)
OCR_ENGINE=paddleocr
OCR_VERSION=PP-OCRv4
OCR_MODEL_VARIANT=mobile
OCR_LANG=tr
OCR_USE_GPU=false
OCR_SERVICE_URL=http://ocr:8080
OCR_PREPROCESS=true
OCR_PREPROCESS_WARP=true
OCR_PREPROCESS_CLAHE=false
OCR_DET_LIMIT_SIDE_LEN=1600

# Otomatik kategorilendirme: bu guvenin altindaki eslesmeler "Diger"e duser ve kullaniciya kontrol ettirilir (0-1)
CATEGORY_MIN_CONFIDENCE=0.5

# Servisler arasi (auth <-> expense) ic API paylasilan anahtari. Ic API ayri portta (9090) calisir ve host'a yayinlanmaz;
# yayinda MUTLAKA uzun rastgele bir deger kullanin (ornek: openssl rand -hex 32).
INTERNAL_TOKEN=dev_internal_token_change_me

# --- Yayın (production) sertleştirmesi ---------------------------------------------------------------------------
# APP_ENV=production iken servisler zayıf/varsayılan sırlarla BAŞLAMAZ (JWT >= 32 karakter, INTERNAL_TOKEN >= 24,
# DB parolası >= 16 karakter ve "dev_"/"change_me" içermemeli).
APP_ENV=development
# Servis başına DB rolü (en az yetki; biri ele geçirilirse diğerinin şemasına erişemez). Yeni kurulumda roller db/10-roles.sh ile
# oluşur; mevcut DB için db/migrate-roles.sql. Yayında süper kullanıcı URL'sini servislere VERMEYİN:
AUTH_DB_PASSWORD=fissio_auth_dev_password
EXPENSE_DB_PASSWORD=fissio_expense_dev_password
# AUTH_DATABASE_URL=postgres://fissio_auth:<AUTH_DB_PASSWORD>@postgres:5432/fissio?sslmode=disable
# EXPENSE_DATABASE_URL=postgres://fissio_expense:<EXPENSE_DB_PASSWORD>@postgres:5432/fissio?sslmode=disable
# Asimetrik access token (önerilir): `docker compose run --rm auth /app genkey`. Özel anahtar YALNIZ auth'a, genel anahtar expense'e;
# doluyken JWT_SECRET/JWT_ACCESS_SECRET kullanılmaz ve HS256 token'lar reddedilir.
# JWT_ED25519_PRIVATE_KEY=
# JWT_ED25519_PUBLIC_KEY=

# E-posta ile otomatik fis aktarimi (Faz 15). INBOUND_EMAIL_DOMAIN bos = ozellik kapali.
# Kullanicilar <rastgele-alias>@INBOUND_EMAIL_DOMAIN adresine fatura mailini yonlendirir; MX kaydi sizin posta yonlendiricinize
# (Cloudflare Email Worker / Mailgun / SendGrid) gider ve o, POST /webhooks/inbound-email'i X-Webhook-Secret basligiyla cagirir.
# Hazir Cloudflare Worker (buyuk mailleri bellege almadan akitir, rawSize denetler): docs/cloudflare-email-worker.js
INBOUND_EMAIL_DOMAIN=
INBOUND_WEBHOOK_SECRET=
INBOUND_MAX_BYTES=15728640
