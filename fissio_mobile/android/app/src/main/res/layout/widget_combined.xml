<?xml version="1.0" encoding="utf-8"?>
<!-- İkili kısayol: solda "Fiş tara" (fissio://scan), sağda "Dijital fiş" (fissio://import-digital). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/widget_scan"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_scan_bg"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_scan_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_scan" />

        <TextView
            android:id="@+id/widget_scan_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/widget_scan_label"
            android:textColor="@color/widget_on_accent"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- RemoteViews yalnızca izinli sınıfları şişirir (Space/View değil): boşluk için FrameLayout. -->
    <FrameLayout
        android:layout_width="8dp"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/widget_digital"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_scan_bg"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_digital_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_digital" />

        <TextView
            android:id="@+id/widget_digital_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/widget_digital_label"
            android:textColor="@color/widget_on_accent"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
