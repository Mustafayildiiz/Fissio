<?xml version="1.0" encoding="utf-8"?>
<!-- Yalnızca "Dijital fiş" kısayolu: dokununca doğrudan PDF seçici (fissio://import-digital). Arka plan/yazı rengi WidgetTheming.kt ile temaya göre. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/widget_action"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_scan_bg"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_action_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_digital" />

        <TextView
            android:id="@+id/widget_action_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/widget_digital_label"
            android:textColor="@color/widget_on_accent"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
